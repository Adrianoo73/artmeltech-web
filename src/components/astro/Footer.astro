---
import BrandLogo from '@/components/astro/BrandLogo.astro';
import { Icon } from '@/components/ui/icons';
import { SocialIcon } from '@/components/ui/SocialIcon';
import { navItems, site } from '@/config/site';
import { getActiveSocials, getContactChannels } from '@/lib/contact';

interface Props {
  rootPrefix?: boolean;
}

const { rootPrefix = false } = Astro.props;
const year = new Date().getFullYear();
const socials = getActiveSocials(site.social);
const channels = getContactChannels(site);
const hrefFor = (id: string) => (rootPrefix ? `/#${id}` : `#${id}`);
---

<footer class="relative overflow-hidden border-t border-sky/18 bg-navy-950 text-white">
  <!-- Trazo superior de acento #EB2F33 -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 top-0 h-[2px] bg-gradient-to-r from-transparent via-accent to-transparent"
  >
  </div>

  <div class="container-site py-14 sm:py-20">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-10">
      <!-- Marca con logotipo oficial más grande y protagonista -->
      <div class="flex flex-col items-start gap-5 lg:col-span-5">
        <a
          href={hrefFor('inicio')}
          aria-label={`${site.name} — Volver al inicio`}
          class="inline-flex hover:opacity-95"
        >
          <BrandLogo surface="plate" size="lg" loading="lazy" />
        </a>
        <p class="max-w-md text-sm leading-relaxed text-white/78">
          {site.description}
        </p>
        <p class="eyebrow text-sky">
          <span aria-hidden="true" class="h-[2px] w-6 rounded-full bg-accent"></span>
          {site.tagline}
        </p>
      </div>

      <!-- Navegación -->
      <nav aria-label="Navegación del pie de página" class="lg:col-span-3">
        <h3 class="flex items-center gap-2 font-display text-xs font-semibold tracking-[0.2em] text-sky uppercase">
          <span aria-hidden="true" class="size-1.5 rounded-full bg-accent"></span>
          Navegación
        </h3>
        <ul class="mt-4 grid grid-cols-2 gap-x-6 gap-y-3 sm:mt-5 sm:grid-cols-1">
          {
            navItems.map((item) => (
              <li>
                <a
                  href={hrefFor(item.id)}
                  class="group inline-flex min-h-10 items-center gap-2 text-sm text-white/78 transition-colors hover:text-white sm:min-h-8"
                >
                  <span
                    aria-hidden="true"
                    class="h-px w-3 bg-sky/50 transition-colors group-hover:bg-accent"
                  />
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Contacto (1.º WhatsApp, 2.º Correo) y redes sociales con iconos visibles -->
      <div class="lg:col-span-4">
        <h3 class="flex items-center gap-2 font-display text-xs font-semibold tracking-[0.2em] text-sky uppercase">
          <span aria-hidden="true" class="size-1.5 rounded-full bg-accent"></span>
          Contacto
        </h3>
        <div class="mt-4 flex flex-col gap-3 text-sm text-white/85 sm:mt-5">
          {
            channels.whatsappUrl && (
              <a
                href={channels.whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="group inline-flex min-h-11 items-center gap-3 self-start rounded-full bg-white py-1.5 pr-4 pl-2 font-display text-xs font-bold text-navy shadow-soft transition-[background-color,transform] duration-200 hover:bg-sky-100 active:scale-[0.98]"
              >
                <span class="grid size-8 place-items-center rounded-full bg-navy text-white transition-colors group-hover:bg-accent">
                  <SocialIcon network="whatsapp" className="size-4" />
                </span>
                <span>WhatsApp directo</span>
              </a>
            )
          }
          {
            channels.mailtoUrl && (
              <a
                href={channels.mailtoUrl}
                class="inline-flex min-h-10 items-center gap-3 transition-colors hover:text-white"
              >
                <Icon name="mail" className="size-4.5 shrink-0 text-sky" />
                <span>{site.contact.email}</span>
              </a>
            )
          }
          {
            channels.telUrl && (
              <a
                href={channels.telUrl}
                class="inline-flex min-h-10 items-center gap-3 transition-colors hover:text-white"
              >
                <Icon name="phone" className="size-4 shrink-0 text-sky" />
                <span>{site.contact.phone}</span>
              </a>
            )
          }
          {
            site.contact.location && (
              <p class="inline-flex items-center gap-3">
                <Icon name="map-pin" className="size-4 shrink-0 text-sky" />
                <span>{site.contact.location}</span>
              </p>
            )
          }
          {
            !channels.hasAnyChannel && !site.contact.location && (
              <p class="text-white/70">
                ¿Listo para conversar sobre tu proyecto?{' '}
                <a
                  href={hrefFor('contacto')}
                  class="font-medium text-sky underline decoration-accent/75 underline-offset-4 transition-colors hover:text-white"
                >
                  Ir a la sección de contacto
                </a>
                .
              </p>
            )
          }
        </div>

        {
          socials.length > 0 && (
            <div class="mt-6">
              <p class="font-display text-xs font-semibold tracking-[0.18em] text-sky uppercase">
                Redes sociales
              </p>
              <ul class="mt-3 flex flex-wrap gap-3">
                {socials.map((item) => (
                  <li>
                    <a
                      href={item.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`${site.name} en ${item.label}`}
                      class="grid size-11 place-items-center rounded-full bg-white text-navy shadow-soft transition-[background-color,color,transform] duration-200 hover:-translate-y-0.5 hover:bg-accent hover:text-white"
                    >
                      <SocialIcon network={item.key} className="size-5" />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>
    </div>

    <div
      class="mt-12 flex flex-col items-start justify-between gap-4 border-t border-white/10 pt-7 text-xs text-white/65 sm:mt-14 sm:flex-row sm:items-center sm:pt-8"
    >
      <p>© {year} {site.legalName}. Todos los derechos reservados.</p>
      <a
        href={hrefFor('inicio')}
        class="inline-flex min-h-9 items-center gap-2 font-display font-semibold text-white/80 transition-colors hover:text-white"
      >
        <span>Volver arriba</span>
        <span
          aria-hidden="true"
          class="grid size-6 place-items-center rounded-full bg-accent text-white"
        >
          ↑
        </span>
      </a>
    </div>
  </div>
</footer>
