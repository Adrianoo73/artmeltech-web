{
  "name": "artmeltech-web",
  "version": "1.0.0",
  "private": true,
  "description": "Sitio web corporativo de ArtMel Tech — Connecting Solutions",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
