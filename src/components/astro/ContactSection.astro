---
import BrandLogo from '@/components/astro/BrandLogo.astro';
import SectionHeading from '@/components/astro/SectionHeading.astro';
import { ContactComposer } from '@/components/react/ContactComposer';
import { Icon } from '@/components/ui/icons';
import { SocialIcon } from '@/components/ui/SocialIcon';
import { site } from '@/config/site';
import { getActiveSocials, getContactChannels } from '@/lib/contact';

const channels = getContactChannels(site);
const socials = getActiveSocials(site.social);
---

<section
  id="contacto"
  aria-labelledby="contacto-title"
  class="section-y relative overflow-hidden bg-navy text-white"
>
  <!-- Fondo técnico atmosférico con parallax y haz de luz -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden">
    <div class="bg-tech-grid mask-radial-fade absolute inset-0 opacity-60"></div>
    <div
      class="beam-x absolute top-[30%] left-0 h-[1.5px] w-44 bg-gradient-to-r from-transparent via-sky/55 to-accent/85"
      style="--beam-dur: 9.5s; --beam-delay: 0.8s"
    >
    </div>
    <div
      data-parallax="30"
      class="animate-drift-slow absolute -top-24 -left-24 h-[34rem] w-[34rem] rounded-full bg-[radial-gradient(circle,rgb(99_156_197/0.22)_0%,rgb(99_156_197/0.06)_40%,transparent_70%)]"
    >
    </div>
    <div
      data-parallax="-24"
      class="absolute right-0 bottom-0 h-[30rem] w-[30rem] rounded-full bg-[radial-gradient(circle,rgb(99_156_197/0.15)_0%,rgb(99_156_197/0.04)_42%,transparent_70%)]"
    >
    </div>
  </div>

  <div class="container-site relative z-10">
    <div class="grid items-start gap-10 lg:grid-cols-12 lg:gap-12">
      <!-- Columna izquierda: mensaje, logo, WhatsApp #1, Correo #2 y Redes visibles -->
      <div class="lg:col-span-5">
        <SectionHeading
          id="contacto-title"
          eyebrow="Contacto"
          title="Conectemos tu próxima"
          highlight="solución."
          lead="Escríbenos directamente por WhatsApp para una atención más rápida, o envíanos un correo si prefieres detallar tu proyecto."
          tone="dark"
        />

        <!-- Presencia del logotipo oficial sobre placa blanca limpia -->
        <div data-reveal="fade" class="mt-6 flex items-center gap-4">
          <BrandLogo surface="plate" size="sm" loading="lazy" />
        </div>

        <!-- Canales configurables: 1.ª opción WhatsApp protagonista, 2.ª opción Correo -->
        <div data-reveal class="mt-6 flex flex-col gap-3.5">
          {
            channels.whatsappUrl && (
              <a
                href={channels.whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="group relative flex min-h-18 items-center justify-between gap-4 overflow-hidden rounded-2xl bg-white p-4 text-navy shadow-[0_16px_38px_-14px_rgb(0_0_0/0.6)] ring-2 ring-accent/70 transition-[transform,background-color,box-shadow] duration-300 ease-out-expo hover:-translate-y-0.5 hover:bg-sky-100"
              >
                <span class="flex items-center gap-3.5">
                  <span class="relative grid size-12 shrink-0 place-items-center rounded-xl bg-navy text-white shadow-soft transition-colors duration-300 group-hover:bg-accent">
                    <SocialIcon network="whatsapp" className="size-6" />
                    <span
                      aria-hidden="true"
                      class="animate-pulse-dot absolute -top-1 -right-1 size-2.5 rounded-full bg-accent/70"
                    />
                    <span
                      aria-hidden="true"
                      class="absolute -top-1 -right-1 size-2.5 rounded-full bg-accent ring-2 ring-white"
                    />
                  </span>
                  <span>
                    <span class="inline-flex items-center gap-1.5 font-display text-[0.6875rem] font-bold tracking-[0.14em] text-navy/70 uppercase">
                      <span aria-hidden="true" class="size-1.5 rounded-full bg-accent" />
                      Opción más rápida · WhatsApp
                    </span>
                    <span class="mt-0.5 block font-display text-base font-bold text-navy">
                      Escríbenos por WhatsApp
                    </span>
                  </span>
                </span>
                <span
                  aria-hidden="true"
                  class="grid size-10 shrink-0 place-items-center rounded-full bg-accent text-white shadow-[0_6px_16px_-4px_rgb(235_47_51/0.65)] transition-transform duration-300 ease-out-expo group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                >
                  <Icon name="arrow-up-right" className="size-4" strokeWidth={2.4} />
                </span>
              </a>
            )
          }

          {
            channels.mailtoUrl && (
              <a
                href={channels.mailtoUrl}
                class="group flex min-h-15 items-center justify-between gap-4 rounded-2xl border border-sky/28 bg-white/[0.05] p-4 transition-[border-color,background-color] duration-200 hover:border-accent hover:bg-white/[0.09]"
              >
                <span class="flex items-center gap-3.5">
                  <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-sky/18 text-sky transition-colors duration-300 group-hover:bg-accent group-hover:text-white">
                    <Icon name="mail" className="size-5" />
                  </span>
                  <span>
                    <span class="block font-display text-[0.6875rem] font-semibold tracking-[0.14em] text-sky uppercase">
                      Correo electrónico
                    </span>
                    <span class="mt-0.5 block text-sm font-semibold text-white">
                      {site.contact.email}
                    </span>
                  </span>
                </span>
                <Icon
                  name="arrow-up-right"
                  className="size-4 shrink-0 text-sky transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-accent"
                />
              </a>
            )
          }

          {
            channels.telUrl && (
              <a
                href={channels.telUrl}
                class="group flex min-h-14 items-center justify-between gap-4 rounded-2xl border border-sky/25 bg-white/[0.04] p-4 transition-[border-color,background-color] duration-200 hover:border-accent hover:bg-white/[0.08]"
              >
                <span class="flex items-center gap-3.5">
                  <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-sky/18 text-sky">
                    <Icon name="phone" className="size-5" />
                  </span>
                  <span>
                    <span class="block font-display text-xs font-semibold tracking-[0.14em] text-sky uppercase">
                      Teléfono
                    </span>
                    <span class="mt-0.5 block text-sm font-medium text-white">
                      {site.contact.phone}
                    </span>
                  </span>
                </span>
                <Icon
                  name="arrow-up-right"
                  className="size-4 text-accent transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                />
              </a>
            )
          }

          {
            (site.contact.location || site.contact.hours) && (
              <div class="flex flex-col gap-3 rounded-2xl border border-sky/22 bg-white/[0.04] p-4">
                {site.contact.location && (
                  <div class="flex items-center gap-3.5">
                    <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-sky/18 text-sky">
                      <Icon name="map-pin" className="size-5" />
                    </span>
                    <span>
                      <span class="block font-display text-[0.6875rem] font-semibold tracking-[0.14em] text-sky uppercase">
                        Ubicación
                      </span>
                      <span class="mt-0.5 block text-sm font-semibold text-white">
                        {site.contact.location}
                      </span>
                    </span>
                  </div>
                )}
                {site.contact.hours && (
                  <p class="flex items-center gap-3 text-sm text-white/80">
                    <Icon name="clock" className="size-4 shrink-0 text-sky" />
                    <span>{site.contact.hours}</span>
                  </p>
                )}
              </div>
            )
          }

          {
            !channels.hasAnyChannel && (
              <div class="rounded-2xl border border-sky/25 border-l-[3px] border-l-accent bg-white/[0.04] p-5">
                <p class="flex items-center gap-2 font-display text-xs font-semibold tracking-[0.16em] text-sky uppercase">
                  <span aria-hidden="true" class="size-1.5 rounded-full bg-accent" />
                  Canales directos editables
                </p>
                <p class="mt-2.5 text-sm leading-relaxed text-white/80">
                  WhatsApp, correo electrónico, teléfono y redes sociales se administran desde un
                  único archivo de configuración y se mostrarán aquí automáticamente al definirlos.
                </p>
              </div>
            )
          }

          {/* Redes sociales con iconos visibles y reconocibles */}
          {
            socials.length > 0 && (
              <div class="mt-2 rounded-2xl border border-sky/22 bg-white/[0.04] p-4 sm:p-5">
                <p class="flex items-center gap-2 font-display text-xs font-semibold tracking-[0.18em] text-sky uppercase">
                  <span aria-hidden="true" class="h-[2px] w-5 rounded-full bg-accent" />
                  Síguenos en redes sociales
                </p>
                <ul class="mt-3.5 grid grid-cols-3 gap-2.5">
                  {socials.map((item) => (
                    <li>
                      <a
                        href={item.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`${site.name} en ${item.label}`}
                        class="group flex min-h-14 flex-col items-center justify-center gap-1.5 rounded-xl border border-sky/25 bg-navy-900/70 px-2 py-3 text-xs font-semibold text-white transition-[border-color,background-color,transform] duration-200 hover:-translate-y-0.5 hover:border-accent hover:bg-white/[0.08]"
                      >
                        <span class="grid size-9 place-items-center rounded-full bg-white text-navy shadow-soft transition-colors duration-200 group-hover:bg-accent group-hover:text-white">
                          <SocialIcon network={item.key} className="size-4.5" />
                        </span>
                        <span class="font-display text-[0.72rem]">{item.label}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </div>
      </div>

      <!-- Columna derecha: compositor interactivo -->
      <div class="lg:col-span-7">
        <ContactComposer
          client:visible
          whatsapp={site.contact.whatsapp}
          email={site.contact.email}
          defaultMessage={site.contact.whatsappMessage}
        />
      </div>
    </div>
  </div>
</section>
