---
import '@fontsource-variable/montserrat/wght.css';
import '@fontsource-variable/inter/wght.css';
import '@/styles/global.css';
import montserratLatin from '@fontsource-variable/montserrat/files/montserrat-latin-wght-normal.woff2?url';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import Preloader from '@/components/astro/Preloader.astro';
import Seo from '@/components/astro/Seo.astro';
import WhatsAppFloat from '@/components/astro/WhatsAppFloat.astro';
import { site } from '@/config/site';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  noindex?: boolean;
  showPreloader?: boolean;
}

const { showPreloader = true, ...seoProps } = Astro.props;
---

<!doctype html>
<html lang={site.lang} dir="ltr" data-preloader={showPreloader ? '1' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content={site.themeColor} />
    <meta name="color-scheme" content="light" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="generator" content={Astro.generator} />

    <!--
      Mejora progresiva: la clase `js` habilita los estados iniciales de las animaciones.
      Salvaguarda: si el módulo de animación no se inicializa en 2.8 s, se retira la clase
      y se remueve la pantalla de carga para que el contenido quede siempre accesible.
    -->
    <script is:inline>
      (() => {
        const d = document.documentElement;
        d.classList.add('js');
        if (d.dataset.preloader && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          d.classList.add('preloader-lock');
        }
        setTimeout(() => {
          if (!('revealReady' in d.dataset)) d.classList.remove('js');
          d.classList.remove('preloader-lock');
          const el = document.getElementById('site-preloader');
          if (el) el.remove();
        }, 4200);
      })();
    </script>
    <!-- Sin JavaScript: garantiza que ningún estado inicial oculte el contenido -->
    <noscript>
      <style>
        [style*='opacity:'] {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>

    <link rel="preload" href={montserratLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <Seo {...seoProps} />
  </head>
  <body class="min-h-dvh bg-white text-navy">
    {showPreloader && <Preloader />}
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:rounded-full focus:bg-white focus:px-5 focus:py-3 focus:font-semibold focus:text-navy focus:shadow-soft"
    >
      Saltar al contenido
    </a>
    <slot name="header" />
    <main id="contenido" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <slot name="footer" />
    <WhatsAppFloat />

    <script>
      import { initMagnetic } from '@/lib/motion/interactions';
      import { initPreloader } from '@/lib/motion/preloader';
      import { initReveal } from '@/lib/motion/reveal';
      import { initSpotlight } from '@/lib/spotlight';

      initPreloader();
      initReveal();
      initSpotlight();
      initMagnetic();
    </script>
  </body>
</html>
