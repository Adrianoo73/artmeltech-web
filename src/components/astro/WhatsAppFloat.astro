---
import { SocialIcon } from '@/components/ui/SocialIcon';
import { site } from '@/config/site';
import { getContactChannels } from '@/lib/contact';

const channels = getContactChannels(site);
---

{
  channels.whatsappUrl && (
    <a
      href={channels.whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="group fixed right-4 bottom-4 z-40 inline-flex items-center gap-2.5 rounded-full border border-navy/15 bg-white p-3 font-display text-xs font-bold text-navy shadow-[0_14px_34px_-10px_rgb(3_32_61/0.6)] ring-2 ring-accent/75 transition-[transform,box-shadow,background-color] duration-300 ease-out-expo hover:-translate-y-1 hover:bg-sky-100 hover:shadow-[0_18px_40px_-10px_rgb(235_47_51/0.45)] active:scale-95 sm:right-6 sm:bottom-6 sm:py-2.5 sm:pr-5 sm:pl-3"
    >
      <span class="relative grid size-9 shrink-0 place-items-center rounded-full bg-navy text-white transition-colors duration-300 group-hover:bg-accent sm:size-10">
        <SocialIcon network="whatsapp" className="size-5" />
        <span
          aria-hidden="true"
          class="animate-pulse-dot absolute -top-0.5 -right-0.5 size-2.5 rounded-full bg-accent/70"
        />
        <span
          aria-hidden="true"
          class="absolute -top-0.5 -right-0.5 size-2.5 rounded-full bg-accent ring-2 ring-white"
        />
      </span>
      <span class="sr-only sm:not-sr-only sm:flex sm:flex-col sm:leading-tight">
        <span class="text-[0.6875rem] font-semibold tracking-[0.12em] text-navy/65 uppercase">
          WhatsApp
        </span>
        <span class="text-xs font-bold text-navy">Contáctanos ahora</span>
      </span>
    </a>
  )
}
