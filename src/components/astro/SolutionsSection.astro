---
import SectionHeading from '@/components/astro/SectionHeading.astro';
import { Icon } from '@/components/ui/icons';
import { solutions, solutionsIntro } from '@/content/solutions';
---

<section
  id="soluciones"
  aria-labelledby="soluciones-title"
  class="section-y relative overflow-hidden bg-surface text-navy"
>
  <div class="container-site">
    <SectionHeading
      id="soluciones-title"
      eyebrow={solutionsIntro.eyebrow}
      title={solutionsIntro.title}
      highlight={solutionsIntro.titleHighlight}
      lead={solutionsIntro.lead}
      tone="light"
    />

    <!-- Cuadrícula Bento conectada (equilibrada en móvil, tablet y escritorio) -->
    <div
      data-reveal-group
      class="mt-10 grid gap-4 sm:mt-12 sm:gap-5 md:grid-cols-6 lg:mt-16 lg:grid-cols-12 lg:gap-6"
    >
      {
        solutions.map((solution, idx) => {
          const isFeatured = idx === 0;
          const spanClasses = [
            'md:col-span-6 lg:col-span-7',
            'md:col-span-3 lg:col-span-5',
            'md:col-span-3 lg:col-span-5',
            'md:col-span-3 lg:col-span-7',
            'md:col-span-3 lg:col-span-6',
            'md:col-span-6 lg:col-span-6',
          ];
          const spanClass = spanClasses[idx] ?? 'md:col-span-3 lg:col-span-6';

          return (
            <article
              data-reveal="card"
              class:list={[
                'spotlight group relative flex flex-col justify-between overflow-hidden rounded-[var(--radius-card)] p-5 transition-[border-color,transform,box-shadow] duration-300 ease-out-quart hover:-translate-y-1.5 sm:p-8',
                spanClass,
                isFeatured
                  ? 'bg-tech-grid border border-sky/25 border-l-[3px] border-l-accent bg-navy text-white shadow-soft'
                  : 'border border-navy/10 bg-white text-navy hover:border-accent/55 hover:shadow-soft',
              ]}
            >
              {isFeatured && (
                <div
                  aria-hidden="true"
                  data-parallax="22"
                  class="pointer-events-none absolute -right-12 -bottom-16 size-72 rounded-full bg-[radial-gradient(circle,rgb(99_156_197/0.3)_0%,rgb(99_156_197/0.09)_42%,transparent_70%)]"
                />
              )}

              {/* Trazo conector SVG que se dibuja dinámicamente al entrar en pantalla */}
              <svg
                aria-hidden="true"
                viewBox="0 0 80 32"
                fill="none"
                class="pointer-events-none absolute top-4 right-4 h-7 w-16 opacity-80 transition-opacity duration-300 group-hover:opacity-100 sm:top-5 sm:right-5"
              >
                <path
                  d="M2 24 L24 24 L38 10 L72 10"
                  data-reveal="draw"
                  pathLength="1"
                  stroke="#639CC5"
                  stroke-opacity={isFeatured ? '0.8' : '0.6'}
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
                <circle
                  cx="72"
                  cy="10"
                  r="3.5"
                  fill={idx % 2 === 0 ? '#EB2F33' : '#639CC5'}
                />
              </svg>

              <div class="relative">
                <div
                  class:list={[
                    'grid size-11 place-items-center rounded-2xl transition-[background-color,color,transform] duration-300 ease-out-expo group-hover:scale-110 group-hover:-rotate-6 sm:size-12',
                    isFeatured
                      ? 'border border-accent/50 bg-accent/18 text-white'
                      : 'border border-sky/35 bg-surface text-navy group-hover:border-accent group-hover:bg-accent group-hover:text-white',
                  ]}
                >
                  <Icon name={solution.icon} className="size-5" />
                </div>

                <h3
                  class:list={[
                    'mt-5 font-display font-bold sm:mt-6',
                    isFeatured ? 'text-xl text-white sm:text-[1.75rem]' : 'text-h3 text-navy',
                  ]}
                >
                  {solution.title}
                </h3>

                <p
                  class:list={[
                    'mt-2.5 leading-relaxed sm:mt-3',
                    isFeatured
                      ? 'max-w-xl text-sm text-white/80 sm:text-base'
                      : 'text-sm text-ink-muted sm:text-[0.9375rem]',
                  ]}
                >
                  {solution.description}
                </p>
              </div>

              <div
                class:list={[
                  'relative mt-6 flex items-center justify-between gap-3 border-t pt-4 sm:mt-8 sm:pt-5',
                  isFeatured ? 'border-white/14' : 'border-navy/8',
                ]}
              >
                <span
                  class:list={[
                    'inline-flex items-center gap-2 font-display text-xs font-semibold tracking-[0.04em]',
                    isFeatured ? 'text-sky-200' : 'text-navy',
                  ]}
                >
                  <span aria-hidden="true" class="size-2 rounded-full bg-accent" />
                  {solution.outcome}
                </span>
                <a
                  href="#contacto"
                  aria-label={`Conversar sobre ${solution.title}`}
                  class:list={[
                    'inline-flex size-9 items-center justify-center rounded-full border transition-[background-color,color,border-color,transform] duration-300 group-hover:translate-x-0.5',
                    isFeatured
                      ? 'border-accent/60 bg-accent text-white hover:bg-white hover:text-navy'
                      : 'border-navy/15 text-navy hover:border-accent hover:bg-accent hover:text-white',
                  ]}
                >
                  <Icon name="arrow-up-right" className="size-4" />
                </a>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
