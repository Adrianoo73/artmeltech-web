---
import BrandLogo from '@/components/astro/BrandLogo.astro';
import SectionHeading from '@/components/astro/SectionHeading.astro';
import { Icon } from '@/components/ui/icons';
import { about } from '@/content/home';
---

<section id="nosotros" aria-labelledby="nosotros-title" class="section-y relative overflow-x-clip bg-white text-navy">
  <div class="container-site">
    <div class="grid items-start gap-10 lg:grid-cols-12 lg:gap-16">
      <!-- Columna izquierda: identidad, narrativa y presencia del logotipo oficial -->
      <div class="lg:sticky lg:top-28 lg:col-span-5">
        <SectionHeading
          id="nosotros-title"
          eyebrow={about.eyebrow}
          title={about.title}
          highlight={about.titleHighlight}
          tone="light"
        />

        <p data-reveal class="mt-6 text-base leading-relaxed text-ink-muted sm:mt-7 sm:text-[1.0625rem]">
          {about.intro}
        </p>
        <p data-reveal data-reveal-delay="0.06" class="mt-4 text-base leading-relaxed text-ink-muted">
          {about.body}
        </p>

        <!-- Tarjeta de identidad con el logotipo oficial grande sobre franja blanca + detalle #EB2F33 -->
        <div
          data-reveal="scale"
          data-reveal-delay="0.1"
          class="relative mt-7 overflow-hidden rounded-[var(--radius-card)] border border-navy/12 bg-navy text-white shadow-soft sm:mt-8"
        >
          {/* Franja superior blanca con el logotipo oficial íntegro */}
          <div class="flex items-center justify-between gap-4 border-b-2 border-accent bg-white px-5 py-4 sm:px-6 sm:py-5">
            <BrandLogo surface="plain" size="md" loading="lazy" />
            <span
              aria-hidden="true"
              class="hidden size-2.5 shrink-0 rounded-full bg-accent sm:inline-block"
            />
          </div>

          <div class="bg-tech-grid relative p-5 sm:p-7">
            <div
              aria-hidden="true"
              class="pointer-events-none absolute -right-14 -bottom-14 size-44 rounded-full bg-[radial-gradient(circle,rgb(99_156_197/0.3),transparent_68%)] blur-2xl"
            >
            </div>
            <p class="relative inline-flex items-center gap-2 rounded-full border border-sky/35 bg-white/[0.06] px-3 py-1 font-display text-[0.7rem] font-semibold tracking-[0.14em] text-sky-200 uppercase">
              <Icon name="map-pin" className="size-3.5 text-accent" />
              <span>Riberalta · Beni · Bolivia</span>
            </p>
            <p class="relative mt-4 font-display text-base font-semibold leading-snug text-white sm:text-lg">
              Unimos diseño, desarrollo y soporte técnico para convertir ideas en soluciones
              prácticas<span class="text-accent">.</span>
            </p>
            <div class="relative mt-4 flex flex-wrap gap-2">
              {
                ['Desarrollo', 'Diseño web', 'Soporte técnico', 'Trato cercano'].map((tag, idx) => (
                  <span class="inline-flex items-center gap-1.5 rounded-full border border-sky/30 bg-sky/12 px-3 py-1 font-display text-xs font-medium text-sky-200">
                    <span
                      aria-hidden="true"
                      class:list={['size-1.5 rounded-full', idx === 0 ? 'bg-accent' : 'bg-sky']}
                    />
                    {tag}
                  </span>
                ))
              }
            </div>
          </div>
        </div>
      </div>

      <!-- Columna derecha: Misión, Visión y Filosofía conectadas -->
      <div class="lg:col-span-7">
        <div class="relative">
          <div
            aria-hidden="true"
            class="pointer-events-none absolute top-10 bottom-10 left-7 hidden w-0.5 bg-navy/10 sm:block"
          >
          </div>
          <div
            aria-hidden="true"
            data-scroll-line
            class="pointer-events-none absolute top-10 bottom-10 left-7 hidden w-0.5 origin-top bg-gradient-to-b from-accent via-sky to-accent sm:block"
          >
          </div>

          <ol data-reveal-group class="flex flex-col gap-4 sm:gap-6">
            {
              about.pillars.map((pillar, idx) => (
                <li
                  data-reveal="right"
                  class="spotlight group relative rounded-[var(--radius-card)] border border-navy/10 bg-surface p-5 transition-[border-color,box-shadow,transform] duration-300 ease-out-quart hover:-translate-y-1 hover:border-accent/55 hover:bg-white hover:shadow-soft sm:p-8 sm:pl-20"
                >
                  <div
                    aria-hidden="true"
                    class="relative mb-4 inline-flex size-11 items-center justify-center rounded-2xl bg-navy text-sky shadow-soft ring-4 ring-white transition-transform duration-300 ease-out-expo group-hover:scale-110 group-hover:-rotate-6 sm:absolute sm:top-8 sm:left-1.5 sm:mb-0"
                  >
                    <Icon name={pillar.icon} className="size-5" />
                    <span class="absolute -top-0.5 -right-0.5 size-2.5 rounded-full bg-accent ring-2 ring-white" />
                  </div>

                  <div class="flex items-center justify-between gap-4">
                    <h3 class="text-h3 font-bold text-navy">{pillar.label}</h3>
                    <span class="inline-flex items-center gap-1.5 font-display text-xs font-bold tracking-[0.16em] text-navy/55">
                      <span aria-hidden="true" class="size-1.5 rounded-full bg-accent" />
                      0{idx + 1}
                    </span>
                  </div>
                  <p class="mt-2.5 text-sm leading-relaxed text-ink-muted sm:mt-3 sm:text-base">
                    {pillar.text}
                  </p>
                </li>
              ))
            }
          </ol>
        </div>

        <!-- Principios / Valores -->
        <div class="mt-9 border-t border-navy/10 pt-7 sm:mt-10 sm:pt-8">
          <p data-reveal="fade" class="eyebrow text-navy/75">
            <span aria-hidden="true" class="h-[2px] w-6 rounded-full bg-accent"></span>
            Cómo trabajamos
          </p>
          <ul data-reveal-group class="mt-4 grid gap-3.5 sm:mt-5 sm:grid-cols-2 sm:gap-4">
            {
              about.values.map((val) => (
                <li
                  data-reveal="card"
                  class="rounded-2xl border border-navy/10 border-l-[3px] border-l-accent/80 bg-white p-4 transition-[border-color,box-shadow,transform] duration-300 hover:-translate-y-1 hover:border-sky/60 hover:border-l-accent hover:shadow-soft sm:p-5"
                >
                  <h4 class="flex items-center gap-2 font-display text-sm font-bold text-navy">
                    <span aria-hidden="true" class="size-1.5 rounded-full bg-accent" />
                    {val.label}
                  </h4>
                  <p class="mt-1.5 text-sm leading-relaxed text-ink-muted sm:mt-2">{val.text}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
